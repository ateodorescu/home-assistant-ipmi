{
  "config": {
    "step": {
      "user": {
        "title": "Connect to the IPMI server",
        "description": "Enter the BMC connection details. Leave advanced options unchecked unless you need addon, Kg key, or privilege settings.",
        "data": {
          "alias": "[%key:common::config_flow::data::alias%]",
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]",
          "advanced": "Configure advanced options"
        },
        "data_description": {
          "host": "BMC hostname or IP address",
          "port": "IPMI / RMCP port (usually 623)",
          "advanced": "Addon URL, interface, Kg key, privilege level, FRU checksum, and sensor filters"
        }
      },
      "advanced": {
        "title": "Advanced IPMI settings",
        "description": "Defaults work for most setups. Use the addon host/port when the ipmi-server addon or standalone container is available. Sensor filters apply to newly discovered sensors.",
        "data": {
          "kg_key": "Kg encryption key",
          "privilege_level": "Privilege level",
          "ipmi_server_host": "ipmi-server host",
          "addon_port": "ipmi-server port",
          "addon_interface": "ipmitool interface",
          "addon_extra_params": "Extra ipmitool parameters",
          "ignore_checksum_errors": "Ignore FRU checksum errors",
          "sensor_types": "Sensor types to discover"
        },
        "data_description": {
          "kg_key": "Optional. Requires the ipmi-server addon; not supported by the python-ipmi fallback.",
          "ipmi_server_host": "On Home Assistant OS use the addon hostname, not localhost.",
          "addon_interface": "Usually lanplus. Use auto to let ipmitool decide.",
          "addon_extra_params": "Optional raw ipmitool arguments (for example cipher suite).",
          "sensor_types": "Only selected types are created for newly discovered sensors. Defaults match previous behavior (all types)."
        }
      },
      "reconfigure": {
        "title": "Reconfigure IPMI server",
        "description": "Update BMC connection details for this entry.",
        "data": {
          "alias": "[%key:common::config_flow::data::alias%]",
          "host": "[%key:common::config_flow::data::host%]",
          "port": "[%key:common::config_flow::data::port%]",
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]",
          "advanced": "Configure advanced options"
        }
      },
      "reconfigure_advanced": {
        "title": "Advanced IPMI settings",
        "description": "[%key:component::ipmi::config::step::advanced::description%]",
        "data": {
          "kg_key": "[%key:component::ipmi::config::step::advanced::data::kg_key%]",
          "privilege_level": "[%key:component::ipmi::config::step::advanced::data::privilege_level%]",
          "ipmi_server_host": "[%key:component::ipmi::config::step::advanced::data::ipmi_server_host%]",
          "addon_port": "[%key:component::ipmi::config::step::advanced::data::addon_port%]",
          "addon_interface": "[%key:component::ipmi::config::step::advanced::data::addon_interface%]",
          "addon_extra_params": "[%key:component::ipmi::config::step::advanced::data::addon_extra_params%]",
          "ignore_checksum_errors": "[%key:component::ipmi::config::step::advanced::data::ignore_checksum_errors%]",
          "sensor_types": "[%key:component::ipmi::config::step::advanced::data::sensor_types%]"
        }
      },
      "reauth_confirm": {
        "title": "Reauthenticate IPMI server",
        "description": "Authentication failed for {host}. Enter updated credentials.",
        "data": {
          "username": "[%key:common::config_flow::data::username%]",
          "password": "[%key:common::config_flow::data::password%]"
        }
      }
    },
    "error": {
      "cannot_connect": "[%key:common::config_flow::error::cannot_connect%]",
      "unknown": "[%key:common::config_flow::error::unknown%]"
    },
    "abort": {
      "already_configured": "[%key:common::config_flow::abort::already_configured_device%]",
      "reconfigure_successful": "Reconfigured successfully",
      "reauth_successful": "Reauthenticated successfully"
    }
